---
interface Props {
  title: string;
  tagline: string;
  example: string;
}

const { title, tagline, example } = Astro.props;
---

<article class="method-card research-method-card">
  <header class="research-method-card__header">
    <h3>{title}</h3>
    <p>{tagline}</p>
  </header>
  <div class="method-visual"><slot /></div>
  <p class="method-example"><strong>例：</strong>{example}</p>
</article>

<style is:global>
  .research-method-grid{grid-template-columns:1fr;gap:18px}.research-method-card{min-height:0;padding:22px}.research-method-card__header{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:15px}.research-method-card__header p{margin:0!important;text-align:right}.method-visual{display:flex;align-items:center;justify-content:center;min-height:154px;margin-bottom:14px;padding:16px;background:#1e222b;border:1px solid var(--border);border-radius:10px;overflow:auto}.method-example{padding-top:12px!important;border-top:1px dashed var(--border)}.method-example strong{color:var(--accent)}.empathy-map{display:grid;grid-template-columns:repeat(2,minmax(145px,1fr));gap:8px;width:min(100%,440px)}.empathy-map div{padding:10px;border:1px solid rgba(125,211,252,.35);border-radius:8px;background:rgba(125,211,252,.08);font-size:12px}.empathy-map b{display:block;margin-bottom:4px;color:var(--accent);font-size:11px}.journey-map{display:flex;align-items:end;gap:7px;width:min(100%,480px);height:122px;padding-top:8px}.journey-step{display:grid;grid-template-rows:22px 1fr 22px;justify-items:center;gap:4px;flex:1;min-width:62px;font-size:14px}.journey-step i{align-self:end;width:100%;height:42px;background:rgba(125,211,252,.22);border:1px solid rgba(125,211,252,.5);border-radius:6px 6px 0 0}.journey-step--high i{height:65px}.journey-step--low i{height:24px;background:rgba(251,113,133,.2);border-color:rgba(251,113,133,.55)}.journey-step small{color:var(--muted);font-size:11px;text-align:center}.persona-preview{display:flex;gap:14px;align-items:flex-start;max-width:440px;padding:14px 16px;border:1px solid rgba(167,139,250,.4);border-radius:10px;background:rgba(167,139,250,.08);font-size:12px}.persona-preview>div>b{color:var(--accent2);font-size:14px}.persona-preview p{margin:5px 0 0!important;color:var(--text)!important}.persona-preview p strong{color:var(--muted)}.persona-avatar{display:grid;place-items:center;flex:0 0 auto;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#0f1115;font-weight:800;font-size:16px}.interview-preview{display:grid;gap:8px;width:min(100%,410px);font-size:12px}.interview-preview p{width:max-content;max-width:80%;margin:0!important;padding:8px 12px;border:1px solid;border-radius:14px}.interview-question{border-color:rgba(125,211,252,.4)!important;background:rgba(125,211,252,.12);color:var(--text)!important}.interview-answer{justify-self:end;border-color:rgba(167,139,250,.4)!important;background:rgba(167,139,250,.12);color:var(--text)!important}.observation-preview{text-align:center}.observation-preview>span{font-size:29px}.observation-preview p{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;margin:7px 0 0!important;font-size:12px}.observation-preview mark{padding:6px 10px;border:1px solid rgba(52,211,153,.5);border-radius:999px;background:rgba(52,211,153,.1);color:#6ee7b7}.observation-preview i{color:var(--muted);font-style:normal}.resource-note{padding:16px 18px;border:1px solid rgba(251,191,36,.36);border-radius:10px;background:rgba(251,191,36,.07);color:#f5d786;font-size:13px}.resource-note p{margin:0!important;color:inherit!important}.resource-note p+p{margin-top:12px!important;padding-top:12px;border-top:1px dashed rgba(251,191,36,.35);color:var(--muted)!important}.resource-note strong{color:#fbbf24}.research-toolkit,.resource-list{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.research-toolkit{margin:18px 0}.research-toolkit article,.resource-list article{border:1px solid var(--border);border-radius:10px;background:var(--surface);padding:18px}.research-toolkit span{font:700 12px var(--mono);color:var(--accent)}.research-toolkit h3,.resource-list h3{margin:10px 0 7px;font-size:16px}.research-toolkit p,.resource-list p{margin:0!important;color:var(--muted)!important;font-size:13px}.resource-list{grid-template-columns:repeat(2,1fr);margin:18px 0 30px}.resource-list a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}@media(max-width:720px){.research-method-card__header{display:block}.research-method-card__header p{text-align:left;margin-top:4px!important}.method-visual{padding:12px}.journey-map{min-width:360px}.empathy-map{grid-template-columns:1fr}.observation-preview p{display:grid}.observation-preview i{transform:rotate(90deg)}.research-toolkit,.resource-list{grid-template-columns:1fr}}
</style>
