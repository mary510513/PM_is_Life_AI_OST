rgin:0}.test-contract div{padding:10px;border:1px solid var(--border);border-radius:8px;background:#1e222b}.test-contract div:last-child{grid-column:1/-1;border-color:rgba(251,191,36,.4);background:rgba(251,191,36,.06)}.test-contract dt{margin-bottom:3px;color:var(--accent);font-size:11px;font-weight:700}.test-contract dd{margin:0;color:#d1d5db;font-size:12px;line-height:1.55}@media(max-width:720px){.scope-slice,.test-contract{grid-template-columns:1fr}.test-contract div:last-child{grid-column:auto}}
</style>
