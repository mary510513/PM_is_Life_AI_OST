---
import BaseLayout from '../../layouts/BaseLayout.astro';
export function getStaticPaths() {
  return ['1-2','1-3','2-1','2-2','2-3','3-1','3-2','3-3','4-1','4-2','4-3','4-4'].map((chapter) => ({ params: { chapter } }));
}
const { chapter } = Astro.params;
---
<BaseLayout title={`${chapter} — PM is Life`}><section class="shell simple-page"><p class="eyebrow">CHAPTER {chapter?.replace('-', '.')}</p><h1>這個章節正在遷移。</h1><p>網站骨架、導覽與內容欄位已準備完成；正式內容將在階段 2 依規格書逐章加入。</p><a class="button primary" href="/handbook/">回到手冊總覽 →</a></section></BaseLayout>
