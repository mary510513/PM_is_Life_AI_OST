---
import BaseLayout from '../layouts/BaseLayout.astro';

const volunteers = [
  'A9', 'Joann', 'Paul', 'Rio', '丁哥', '傑佛瑞', '墨暘', '攝影師', '書僮', '瑄', '羽',
];
---
<BaseLayout title="PM is Life — AI 工具介紹手冊" description="從問題、PRD 到可驗證的成果，和 AI 一起走完產品思考流程。">
  <section class="hero shell"><p class="eyebrow">BUILD WITH AI @ OST</p><h1>把模糊想法，<br /><em>做成下一步。</em></h1><p class="hero-copy">這不是一條必須照順序走完的路，而是一套能在你卡住時隨時打開的產品工具箱。</p><div class="hero-actions"><a class="button primary" href="/handbook/">開始閱讀 →</a><a class="button ghost" href="/methods/">瀏覽方法工具庫</a></div></section>
  <section class="shell route-section"><p class="eyebrow">THE PLAYBOOK</p><h2>從一個問題，走到能驗證的東西</h2><div class="part-grid"><a class="part-card" href="/handbook/1-1/"><span>01</span><h3>從需求開始</h3><p>找到、理解、收斂真正值得處理的問題。</p><b>1.1 — 1.3</b></a><a class="part-card" href="/handbook/2-1/"><span>02</span><h3>形成 PRD</h3><p>把問題轉成產品機會，組裝成可檢查的規格。</p><b>2.1 — 2.3</b></a><a class="part-card" href="/handbook/3-1/"><span>03</span><h3>做出成果</h3><p>選擇完成度、做出東西，再讀懂回饋。</p><b>3.1 — 3.3</b></a><a class="part-card" href="/handbook/4-1/"><span>04</span><h3>回頭地圖</h3><p>在任何卡點重新進入，找到下一個動作。</p><b>4.1 — 4.4</b></a></div></section>
  <section class="shell community-section" aria-labelledby="community-title">
    <div class="community-copy">
      <p class="eyebrow">BUILD TOGETHER</p>
      <h2 id="community-title">一起把想法，<br /><em>做成下一步。</em></h2>
      <p>加入 LINE 社群，和一起練習、討論產品思考的人交流，也把你的下一個問題帶進來。</p>
      <a class="button primary" href="https://line.me/ti/g2/_okkDEjzob9qaUP5IFIT0WE8nse_qgz60OfmKA?utm_source=invitation&utm_medium=link_copy&utm_campaign=default" target="_blank" rel="noreferrer">加入 LINE 社群 ↗</a>
    </div>
    <a class="qr-card" href="https://line.me/ti/g2/_okkDEjzob9qaUP5IFIT0WE8nse_qgz60OfmKA?utm_source=invitation&utm_medium=link_copy&utm_campaign=default" target="_blank" rel="noreferrer" aria-label="掃描 QR Code 或開啟 LINE 社群連結">
      <img src="/line-community-qr.svg" alt="加入 PM is Life LINE 社群的 QR Code" width="180" height="180" />
      <span>掃描加入 LINE 社群</span>
    </a>
  </section>
  <section class="shell volunteer-section" aria-labelledby="volunteer-title">
    <div class="volunteer-heading">
      <p class="eyebrow">THE PEOPLE BEHIND IT</p>
      <h2 id="volunteer-title">謝謝每一位志工</h2>
      <p>這本手冊，因為大家的投入才得以完成。</p>
    </div>
    <ul class="volunteer-grid" role="list">
      {volunteers.map((name) => <li><img src={`/volunteers/${name}.jpeg`} alt={`${name} 志工頭像`} loading="lazy" /><span>{name}</span></li>)}
    </ul>
  </section>
  <style>
    .community-section { display: grid; grid-template-columns: minmax(0, 1fr) 248px; gap: 72px; align-items: center; padding: 80px 0; border-top: 1px solid var(--border); }
    .community-copy h2, .volunteer-heading h2 { margin: 0; font-size: clamp(34px, 4vw, 52px); line-height: 1.1; letter-spacing: -.055em; }
    .community-copy h2 em { font-family: Georgia, serif; font-weight: 400; color: var(--accent); }
    .community-copy > p:not(.eyebrow) { max-width: 500px; margin: 22px 0 26px; color: var(--muted); font-size: 17px; }
    .qr-card { justify-self: end; display: grid; gap: 11px; place-items: center; width: 248px; padding: 22px 20px 18px; border-radius: var(--radius); background: #fff; color: #10131a; text-align: center; box-shadow: 0 12px 30px #0003; }
    .qr-card img { display: block; width: 180px; height: 180px; }
    .qr-card span { font-size: 12px; font-weight: 700; }
    .volunteer-section { padding: 84px 0 8px; border-top: 1px solid var(--border); }
    .volunteer-heading { margin-bottom: 34px; }
    .volunteer-heading > p:not(.eyebrow) { margin: 10px 0 0; color: var(--muted); font-size: 16px; }
    .volunteer-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 22px 18px; margin: 0; padding: 0; list-style: none; }
    .volunteer-grid li { min-width: 0; text-align: center; }
    .volunteer-grid img { display: block; aspect-ratio: 1; object-fit: cover; width: 100%; max-width: 132px; margin: 0 auto 9px; border: 1px solid var(--border); border-radius: 50%; background: var(--surface); filter: saturate(.92); transition: transform .2s ease, filter .2s ease; }
    .volunteer-grid li:hover img { filter: saturate(1.08); transform: translateY(-3px); }
    .volunteer-grid span { display: block; overflow: hidden; color: #d1d5db; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; font-weight: 700; }
    @media (max-width: 720px) { .community-section { grid-template-columns: 1fr; gap: 34px; padding: 58px 0; } .qr-card { justify-self: start; } .volunteer-section { padding-top: 58px; } .volunteer-grid { grid-template-columns: repeat(4, 1fr); gap: 20px 12px; } .volunteer-grid img { max-width: 100px; } }
  </style>
</BaseLayout>
